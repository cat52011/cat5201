      "TopText": "\u7D66\u6211\u570B\u7ACB\u81FA\u5317\u6559\u80B2\u5927\u5B78\u7684\u57FA\u672C\u4ECB\u7D39",
      "BottomText": "\u570B\u7ACB\u81FA\u5317\u6559\u80B2\u5927\u5B78\uFF08National Taipei University of Education\uFF0C\u7C21\u7A31\u5317\u6559\u5927\uFF09\u5275\u7ACB\u65BC1895\u5E74\uFF0C\u4F4D\u65BC\u81FA\u5317\u5E02\u5927\u5B89\u5340\u548C\u5E73\u6771\u8DEF\u4E8C\u6BB5134\u865F\uFF0C\u662F\u4E00\u6240\u5C08\u6CE8\u6559\u80B2\u8207\u4EBA\u6587\u85DD\u8853\u9818\u57DF\u7684\u570B\u7ACB\u5927\u5B78\u3002[1][5]\n\n### \u6B77\u53F2\u6CBF\u9769\n- 1895\u5E74\u5275\u7ACB\uFF0C\u521D\u540D**\u829D\u5C71\u5DD6\u5B78\u5802**\uFF0C\u7FCC\u5E74\u6539\u7A31\u81FA\u7063\u7E3D\u7763\u5E9C\u570B\u8A9E\u5B78\u6821\u3002\n- 1919\u5E74\u6539\u540D**\u81FA\u7063\u7E3D\u7763\u5E9C\u81FA\u5317\u5E2B\u7BC4\u5B78\u6821**\u3002\n- 1927\u5E74\u5206\u5272\u70BA\u81FA\u5317\u7B2C\u4E00\u5E2B\u7BC4\u5B78\u6821\uFF08\u4ECA\u81FA\u5317\u5E02\u7ACB\u5927\u5B78\u524D\u8EAB\uFF09\u8207\u81FA\u5317\u7B2C\u4E8C\u5E2B\u7BC4\u5B78\u6821\uFF08\u4ECA\u5317\u6559\u5927\u524D\u8EAB\uFF0C\u4F4D\u65BC\u82B3\u862D\u6821\u5340\uFF09\u3002\n- 1943\u5E74\u5169\u6821\u5408\u4F75\uFF0C1945\u5E74\u6230\u5F8C\u66F4\u540D**\u81FA\u7063\u7701\u7ACB\u81FA\u5317\u5E2B\u7BC4\u5B78\u6821**\u3002\n- 1961\u5E74\u6539\u5236\u70BA**\u81FA\u7063\u7701\u7ACB\u81FA\u5317\u5E2B\u7BC4\u5C08\u79D1\u5B78\u6821**\uFF0C1987\u5E74\u5347\u683C\u70BA**\u81FA\u7063\u7701\u7ACB\u81FA\u5317\u5E2B\u7BC4\u5B78\u9662**\u3002\n- 1991\u5E74\u6539\u96B8**\u570B\u7ACB\u81FA\u5317\u5E2B\u7BC4\u5B78\u9662**\uFF0C2005\u5E74\u6B63\u5F0F\u5347\u683C\u70BA**\u570B\u7ACB\u81FA\u5317\u6559\u80B2\u5927\u5B78**\u3002[1]\n\n### \u6821\u5712\u8207\u806F\u7D61\u8CC7\u8A0A\n- **\u5730\u5740**\uFF1A\u81FA\u5317\u5E02\u5927\u5B89\u5340\u548C\u5E73\u6771\u8DEF\u4E8C\u6BB5134\u865F\uFF08\u90F5\u905E\u5340\u865F106320\u621610671\uFF0C\u5169\u4F86\u6E90\u7565\u6709\u5DEE\u7570\uFF09\u3002[3][4][5]\n- **\u96FB\u8A71**\uFF1A\u002B886-2-2732-1104 \u6216 \u002B886-2-6639-6688\u3002[3][4][5]\n- **\u50B3\u771F**\uFF1A\u002B886-2-2377-7008\u3002[3][4]\n- **\u5B98\u65B9\u7DB2\u7AD9**\uFF1Ahttps://www.ntue.edu.tw\uFF0C\u63D0\u4F9B\u6821\u5712\u5730\u5716\u3001360VR\u5C0E\u89BD\u3001\u6B77\u4EFB\u6821\u9577\u8207\u7D44\u7E54\u898F\u7AE0\u7B49\u8CC7\u8A0A\u3002[5]\n- \u6821\u5712\u9644\u8A2D\u570B\u5C0F\uFF0C\u4E26\u8A2D\u6709\u6559\u80B2\u5B78\u9662\u3001\u4EBA\u6587\u85DD\u8853\u5B78\u9662\u7B49\u5B78\u8853\u55AE\u4F4D\u3002[5]\n\n### \u6559\u80B2\u7279\u8272\n\u5B78\u6821\u5F37\u8ABF\u6559\u80B2\u5C08\u696D\u57F9\u80B2\uFF0C\u8A2D\u6709\u6559\u80B2\u5B78\u7CFB\u7B49\u55AE\u4F4D\uFF0C\u7279\u8272\u5305\u62EC\u751F\u6DAF\u898F\u5283\u3001\u7814\u7A76\u80FD\u529B\u63D0\u5347\u3001\u570B\u969B\u8996\u91CE\u62D3\u5C55\u3001\u5F31\u52E2\u95DC\u61F7\u8207\u6559\u80B2\u5BE6\u7FD2\u3002[2] \u8FD1\u5E74\u7A4D\u6975\u63A8\u52D5\u570B\u969B\u62DB\u751F\u8207\u96D9\u8A9E\u6559\u5B78\u76F8\u95DC\u6D3B\u52D5\u3002[3][9]",
