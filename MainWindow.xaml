<Window x:Class="test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:test"
        Title="cat5201"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize">

    <Window.Resources>

        <SolidColorBrush x:Key="FileMenuBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FileMenuBorder" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="FileMenuText" Color="#222222"/>
        <SolidColorBrush x:Key="FileMenuDisabled" Color="#A0A0A0"/>

        <Style x:Key="FileContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{StaticResource FileMenuBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FileMenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{StaticResource FileMenuText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border Background="Transparent"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="HeaderPresenter"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HeaderPresenter" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderPresenter" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource FileMenuDisabled}"/>
                                <Setter TargetName="HeaderPresenter" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1"
                                Background="#EAEAEA"
                                CornerRadius="0.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                            <!-- 背景 -->
                            <Border x:Name="SwitchTrack"
                            CornerRadius="11"
                            Background="#D1D1D6"
                            BorderBrush="#D1D1D6"
                            BorderThickness="1"/>

                            <!-- 滑塊 -->
                            <Border x:Name="SwitchThumb"
                            Width="18"
                            Height="18"
                            CornerRadius="9"
                            Background="White"
                            HorizontalAlignment="Left"
                            Margin="2,2,0,2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                              ShadowDepth="1"
                                              Opacity="0.2"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#34C759"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#34C759"/>

                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,2,2,2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- 側邊欄 -->
        <Grid x:Name="Sidebar"
              Width="280"
              Background="#F0F0F0"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Panel.ZIndex="100">
            <Border Padding="12" Background="#F0F0F0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
        Width="22"
        Height="22"
        Margin="0,2,0,0"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Cursor="Hand"
        ToolTip="新增"
        Click="NewFile_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Viewbox x:Name="IconBox"
                         Width="20"
                         Height="20"
                         Stretch="Fill"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                                        <Canvas Width="18" Height="18">
                                            <Path Data="M9,3 L9,15"
                              Stroke="Black"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                                            <Path Data="M3,9 L15,9"
                              Stroke="Black"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="IconBox" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="IconBox" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ListBox x:Name="FileList"
                             Grid.Row="1"
                             Margin="0,10,0,10"
                             Background="Transparent"
                             BorderThickness="0"
                             DisplayMemberPath="DisplayName"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="FileList_MouseDoubleClick"
                             MouseRightButtonUp="FileList_MouseRightButtonUp">

                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Resources>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="#222"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="10">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E6E6E6"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#DCDCDC"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock x:Name="CurrentFileLabel"
                               Grid.Row="2"
                               Text="目前檔案：尚未建立"
                               FontSize="12"
                               Foreground="#555"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <!-- 起始畫面 -->
        <Grid x:Name="StartUI"
              Margin="280,0,0,0"
              Background="White"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="StartMessage"
                           Grid.Row="1"
                           Text="讓我們有個新的開始！"
                           FontSize="28"
                           Foreground="#222"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <Button x:Name="StartButton"
                        Grid.Row="2"
                        Content="開始"
                        Width="100"
                        Height="36"
                        Background="Black"
                        Foreground="White"
                        BorderBrush="Black"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="StartButton_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Padding="6,0"
                        Style="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontSize="16"
                                                  TextElement.Foreground="White"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <Button.Effect>
                        <DropShadowEffect BlurRadius="6"
                                          ShadowDepth="2"
                                          Opacity="0.25"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Grid>

        <!-- 主畫面 -->
        <Grid x:Name="MainUI"
              Visibility="Collapsed">

            <Border x:Name="Viewport"
                    ClipToBounds="True"
                    MouseDown="Viewport_MouseDown"
                    MouseWheel="Viewport_MouseWheel">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ViewportTranslate" X="140" Y="0"/>
                </Border.RenderTransform>

                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="White">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#DDD" Thickness="1"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="20,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,20"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>

                <Canvas x:Name="MainCanvas" Background="Transparent"/>
            </Border>

            <!-- 側邊熱區 -->
            <Grid x:Name="HotZoneContainer"
                  Width="50" Height="200"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Background="Transparent"
                  Visibility="Collapsed"
                  Panel.ZIndex="101"
                  MouseEnter="HotZoneContainer_MouseEnter">

                <Border x:Name="HotZoneHitArea"
                        Width="20" Height="200"
                        Background="Transparent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="ExpandSidebar">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HotZoneBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1.0"
                                                     Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HotZoneBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.3"
                                                     Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>

                <Border x:Name="HotZoneBackground"
                        Background="LightGray"
                        Opacity="0.3"
                        Width="5" Height="200"
                        CornerRadius="2.5"
                        Margin="15,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="8"
                                          ShadowDepth="2"
                                          Opacity="0.4"/>
                    </Border.Effect>
                </Border>
            </Grid>

            <!-- 右上角決策可視化視窗 -->
            <Border x:Name="DecisionPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,18,18,0"
                    Width="320"
                    Padding="14,12"
                    CornerRadius="18"
                    Background="#FAFAFA"
                    BorderBrush="#DADADA"
                    BorderThickness="1"
                    Panel.ZIndex="9999">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="2"
                                      Opacity="0.16"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock Text="決策可視化"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#202020"
                                   VerticalAlignment="Center"/>

                        <Border x:Name="DecisionStatusBadge"
                                DockPanel.Dock="Right"
                                Background="#EDEDED"
                                CornerRadius="9"
                                Padding="8,3"
                                Margin="10,0,0,0">
                            <TextBlock x:Name="DecisionStatusText"
                                       Text="Idle"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#404040"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Height="1"
                            Background="#E8E8E8"/>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模式"
                                   FontSize="12"
                                   Foreground="#707070"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="DecisionModeText"
                                   Grid.Column="1"
                                   Text="Manual"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#202020"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="策略"
                                   FontSize="12"
                                   Foreground="#707070"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="DecisionResolverText"
                                   Grid.Column="1"
                                   Text="Manual"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#202020"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模型"
                                   FontSize="12"
                                   Foreground="#707070"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="DecisionModelText"
                                   Grid.Column="1"
                                   Text="-"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#202020"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="任務 / 信心"
                                   FontSize="12"
                                   Foreground="#707070"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="DecisionTaskText"
                                   Grid.Column="1"
                                   Text="-"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#202020"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右下角自動模型開關 -->
            <Border x:Name="AutoModelSwitchPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,65,18"
                    Padding="10,7"
                    CornerRadius="22"
                    Background="#F7F7F7"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Panel.ZIndex="9999">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="Auto"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#222"/>

                    <CheckBox x:Name="AutoModelSwitch"
                              Style="{StaticResource AppleSwitchStyle}"
                              VerticalAlignment="Center"
                              Checked="AutoModelSwitch_Checked"
                              Unchecked="AutoModelSwitch_Unchecked"/>

                    <Border Margin="8,0,0,0"
                            Width="1"
                            Height="16"
                            Background="#D9D9D9"
                            VerticalAlignment="Center"/>

                    <TextBlock Text="API"
                               VerticalAlignment="Center"
                               Margin="8,0,6,0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#222"/>

                    <CheckBox x:Name="AdvancedAutoResolverSwitch"
                              Style="{StaticResource AppleSwitchStyle}"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              Checked="AdvancedAutoResolverSwitch_Checked"
                              Unchecked="AdvancedAutoResolverSwitch_Unchecked"/>

                </StackPanel>
            </Border>

            <!-- 右下角定位按鈕 -->
            <Button x:Name="CenterOnInitialButton"
                    Width="38" Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="18"
                    Background="#F5F5F5"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CenterOnInitialButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1"/>
                            <Path Data="M19,9 L19,29 M9,19 L29,19"
                                  Stroke="#444"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>

                <Button.Effect>
                    <DropShadowEffect BlurRadius="6"
                                      ShadowDepth="2"
                                      Opacity="0.22"/>
                </Button.Effect>
            </Button>
        </Grid>
    </Grid>
</Window>