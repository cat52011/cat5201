<Window x:Class="test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:test"
        Title="cat5201"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize">

    <Window.Resources>

        <SolidColorBrush x:Key="FileMenuBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FileMenuBorder" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="FileMenuText" Color="#222222"/>
        <SolidColorBrush x:Key="FileMenuDisabled" Color="#A0A0A0"/>

        <Style x:Key="FileContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{StaticResource FileMenuBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FileMenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{StaticResource FileMenuText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border Background="Transparent"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="HeaderPresenter"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HeaderPresenter" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderPresenter" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource FileMenuDisabled}"/>
                                <Setter TargetName="HeaderPresenter" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1"
                                Background="#EAEAEA"
                                CornerRadius="0.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                            <!-- 背景 -->
                            <Border x:Name="SwitchTrack"
                            CornerRadius="11"
                            Background="#D1D1D6"
                            BorderBrush="#D1D1D6"
                            BorderThickness="1"/>

                            <!-- 滑塊 -->
                            <Border x:Name="SwitchThumb"
                            Width="18"
                            Height="18"
                            CornerRadius="9"
                            Background="White"
                            HorizontalAlignment="Left"
                            Margin="2,2,0,2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                              ShadowDepth="1"
                                              Opacity="0.2"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#34C759"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#34C759"/>

                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,2,2,2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- 側邊欄 -->
        <Grid x:Name="Sidebar"
              Width="280"
              Background="#F0F0F0"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Panel.ZIndex="100">
            <Border Padding="12" Background="#F0F0F0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
        Width="22"
        Height="22"
        Margin="0,2,0,0"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Cursor="Hand"
        ToolTip="新增"
        Click="NewFile_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Viewbox x:Name="IconBox"
                         Width="20"
                         Height="20"
                         Stretch="Fill"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                                        <Canvas Width="18" Height="18">
                                            <Path Data="M9,3 L9,15"
                              Stroke="Black"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                                            <Path Data="M3,9 L15,9"
                              Stroke="Black"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="IconBox" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="IconBox" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ListBox x:Name="FileList"
                             Grid.Row="1"
                             Margin="0,10,0,10"
                             Background="Transparent"
                             BorderThickness="0"
                             DisplayMemberPath="DisplayName"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="FileList_MouseDoubleClick"
                             MouseRightButtonUp="FileList_MouseRightButtonUp">

                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Resources>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="#222"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="10">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E6E6E6"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#DCDCDC"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CurrentFileLabel"
                                   Grid.Column="0"
                                   Text="目前檔案：尚未建立"
                                   FontSize="12"
                                   Foreground="#555"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <!-- 左下角：齒輪 → 個人化設定 -->
                        <Button x:Name="SettingsGearButton"
                                Grid.Column="1"
                                Width="34" Height="34"
                                Margin="8,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="個人化設定"
                                Click="OpenSettings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="gbd"
                                            Background="Transparent"
                                            CornerRadius="9">
                                        <Viewbox Width="20" Height="20"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path x:Name="gearIcon"
                                                      Fill="#5A5A5A"
                                                      Data="M19.14,12.94a7.49,7.49,0,0,0,.05-1,7.49,7.49,0,0,0-.05-1l2.11-1.65a.5.5,0,0,0,.12-.64l-2-3.46a.5.5,0,0,0-.61-.22l-2.49,1a7.32,7.32,0,0,0-1.69-1l-.38-2.65A.49.49,0,0,0,13.8,1H9.8a.49.49,0,0,0-.49.42L8.93,4.07a7.32,7.32,0,0,0-1.69,1l-2.49-1a.5.5,0,0,0-.61.22l-2,3.46a.5.5,0,0,0,.12.64L4.5,11a7.49,7.49,0,0,0,0,2L2.39,14.65a.5.5,0,0,0-.12.64l2,3.46a.5.5,0,0,0,.61.22l2.49-1a7.32,7.32,0,0,0,1.69,1l.38,2.65a.49.49,0,0,0,.49.42h4a.49.49,0,0,0,.49-.42l.38-2.65a7.32,7.32,0,0,0,1.69-1l2.49,1a.5.5,0,0,0,.61-.22l2-3.46a.5.5,0,0,0-.12-.64ZM12,15.5A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="gbd" Property="Background" Value="#E2E2E2"/>
                                            <Setter TargetName="gearIcon" Property="Fill" Value="#222"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 起始畫面 -->
        <Grid x:Name="StartUI"
              Margin="280,0,0,0"
              Background="White"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="StartMessage"
                           Grid.Row="1"
                           Text="讓我們有個新的開始！"
                           FontSize="28"
                           Foreground="#222"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <Button x:Name="StartButton"
                        Grid.Row="2"
                        Content="開始"
                        Width="100"
                        Height="36"
                        Background="Black"
                        Foreground="White"
                        BorderBrush="Black"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="StartButton_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Padding="6,0"
                        Style="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontSize="16"
                                                  TextElement.Foreground="White"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <Button.Effect>
                        <DropShadowEffect BlurRadius="6"
                                          ShadowDepth="2"
                                          Opacity="0.25"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Grid>

        <!-- 主畫面 -->
        <Grid x:Name="MainUI"
              Visibility="Collapsed">

            <Border x:Name="Viewport"
                    ClipToBounds="True"
                    MouseDown="Viewport_MouseDown"
                    MouseWheel="Viewport_MouseWheel">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ViewportTranslate" X="140" Y="0"/>
                </Border.RenderTransform>

                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="White">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#DDD" Thickness="1"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="20,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,20"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>

                <Canvas x:Name="MainCanvas" Background="Transparent"/>
            </Border>

            <!-- 側邊熱區 -->
            <Grid x:Name="HotZoneContainer"
                  Width="50" Height="200"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Background="Transparent"
                  Visibility="Collapsed"
                  Panel.ZIndex="101"
                  MouseEnter="HotZoneContainer_MouseEnter">

                <Border x:Name="HotZoneHitArea"
                        Width="20" Height="200"
                        Background="Transparent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="ExpandSidebar">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HotZoneBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1.0"
                                                     Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HotZoneBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.3"
                                                     Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>

                <Border x:Name="HotZoneBackground"
                        Background="LightGray"
                        Opacity="0.3"
                        Width="5" Height="200"
                        CornerRadius="2.5"
                        Margin="15,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="8"
                                          ShadowDepth="2"
                                          Opacity="0.4"/>
                    </Border.Effect>
                </Border>
            </Grid>

            <!-- 右上角決策可視化視窗 -->

            <Border
    x:Name="DecisionPanel"
    Width="340"
    Height="260"
    CornerRadius="18"
    Background="White"
    BorderBrush="#E6E6E6"
    BorderThickness="1"
    Padding="14"
    SnapsToDevicePixels="True"
                HorizontalAlignment="Right"
VerticalAlignment="Top"
Margin="0,20,20,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 上方固定區：標題 + 狀態 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="決策可視化"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#303030"
                       VerticalAlignment="Center"/>

                        <Button x:Name="DecisionPanelToggleButton"
                                Grid.Column="1"
                                Width="26"
                                Height="24"
                                Margin="0,0,8,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="放大決策窗"
                                Click="DecisionPanelToggleButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Viewbox Width="14" Height="14">
                                <Path x:Name="DecisionPanelToggleIcon"
                                      Data="M2,6 L2,2 L6,2 M8,2 L12,2 L12,6 M12,8 L12,12 L8,12 M6,12 L2,12 L2,8"
                                      Stroke="#7A7A7A"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>
                            </Viewbox>
                        </Button>

                        <Border x:Name="DecisionStatusBadge"
                    Grid.Column="2"
                    Background="#EEF7EA"
                    CornerRadius="999"
                    Padding="10,4">
                            <TextBlock x:Name="DecisionStatusText"
                           Text="Rule Auto"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#2E6A2E"/>
                        </Border>
                    </Grid>

                    <!-- 中間分隔 -->
                    <Border Grid.Row="1"
                Margin="0,8,0,0"
                Height="1"
                Background="#ECECEC"/>

                    <!-- 下方可上下捲動內容區 -->
                    <ScrollViewer Grid.Row="2"
              Margin="0,8,0,0"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              CanContentScroll="False"
              PanningMode="VerticalOnly">

                        <StackPanel Margin="0,0,6,0">

                            <!-- 模式 -->
                            <TextBlock Text="模式"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionModeText"
                   Text="-"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <TextBlock Text="Agent"
           FontSize="12"
           Foreground="#7A7A7A"
           Margin="0,0,0,2"/>

                            <TextBlock x:Name="DecisionAgentText"
           Text="-"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="#232323"
           Margin="0,0,0,10"/>

                            <!-- 策略 -->
                            <TextBlock Text="策略"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionResolverText"
                   Text="-"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <!-- 模型 -->
                            <TextBlock Text="模型"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionModelText"
                   Text="-"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <!-- 任務 -->
                            <TextBlock Text="任務"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionTaskText"
                   Text="-"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <!-- Reason -->
                            <TextBlock Text="Reason"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionReasonText"
                   Text="-"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <!-- Keywords -->
                            <TextBlock Text="Keywords"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionKeywordsText"
                   Text="-"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <!-- Capability / Trace -->
                            <TextBlock Text="Capability / Trace"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionExtraText"
                   Text="-"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,14"/>

                            <!-- Timeline -->
                            <Border Height="1"
                Background="#ECECEC"
                Margin="0,0,0,12"/>

                            <TextBlock Text="Decision Timeline"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,8"/>

                            <StackPanel x:Name="DecisionTimelineHost"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右下角自動模型開關 -->
            <Border x:Name="AutoModelSwitchPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,65,18"
                    Padding="10,7"
                    CornerRadius="22"
                    Background="#F7F7F7"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Panel.ZIndex="9999">

                <StackPanel Orientation="Horizontal"
            VerticalAlignment="Center">

                    <TextBlock Text="API"
               VerticalAlignment="Center"
               Margin="0,0,6,0"
               FontSize="12.5"
               FontWeight="SemiBold"
               Foreground="#222"/>

                    <CheckBox x:Name="AdvancedAutoResolverSwitch"
              Style="{StaticResource AppleSwitchStyle}"
              VerticalAlignment="Center"
              Visibility="Collapsed"
              Checked="AdvancedAutoResolverSwitch_Checked"
              Unchecked="AdvancedAutoResolverSwitch_Unchecked"/>

                    <Border Margin="8,0,0,0"
            Width="1"
            Height="16"
            Background="#D9D9D9"
            VerticalAlignment="Center"/>

                    <TextBlock Text="Auto"
               VerticalAlignment="Center"
               Margin="8,0,6,0"
               FontSize="12.5"
               FontWeight="SemiBold"
               Foreground="#222"/>

                    <CheckBox x:Name="AutoModelSwitch"
              Style="{StaticResource AppleSwitchStyle}"
              VerticalAlignment="Center"
              Checked="AutoModelSwitch_Checked"
              Unchecked="AutoModelSwitch_Unchecked"/>

                </StackPanel>
            </Border>

            <!-- 右下角定位按鈕 -->
            <Button x:Name="CenterOnInitialButton"
                    Width="38" Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="18"
                    Background="#F5F5F5"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CenterOnInitialButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1"/>
                            <Path Data="M19,9 L19,29 M9,19 L29,19"
                                  Stroke="#444"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>

                <Button.Effect>
                    <DropShadowEffect BlurRadius="6"
                                      ShadowDepth="2"
                                      Opacity="0.22"/>
                </Button.Effect>
            </Button>
        </Grid>

        <!-- 個人化設定對話框（齒輪點開） -->
        <Grid x:Name="SettingsOverlay"
              Visibility="Collapsed"
              Panel.ZIndex="10000"
              Background="#55000000"
              MouseLeftButtonDown="SettingsOverlay_BackgroundClick">

            <Border Width="440"
                    Height="560"
                    CornerRadius="18"
                    Background="White"
                    BorderBrush="#E6E6E6"
                    BorderThickness="1"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="SettingsCard_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.22"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 標題列 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="個人化設定"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#303030"
                                   VerticalAlignment="Center"/>

                        <Border Grid.Column="1"
                                CornerRadius="999"
                                Background="#F1F1F3"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="MemoryStatsLabel"
                                       Text="偏好 0 條・歷史 0 筆"
                                       FontSize="11.5"
                                       Foreground="#666"/>
                        </Border>

                        <Button Grid.Column="2"
                                Width="28" Height="28"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="關閉"
                                Click="CloseSettings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="cbd" Background="Transparent" CornerRadius="8">
                                        <Path Data="M5,5 L15,15 M15,5 L5,15"
                                              Stroke="#888"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cbd" Property="Background" Value="#EEEEEE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border Grid.Row="0" Height="1" Background="#ECECEC"
                            VerticalAlignment="Bottom" Margin="0,0,0,0"/>

                    <!-- 輸入區 -->
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Text="記憶與偏好"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="告訴它你的偏好，之後每次回答都會遵守。例如：回答用中文與韓文、以後簡潔一點、盡量用便宜的模型。"
                                   FontSize="11.5"
                                   Foreground="#9A9A9E"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Border CornerRadius="10"
                                Background="#F7F7F8"
                                BorderBrush="#E4E4E7"
                                BorderThickness="1"
                                Padding="10,8">
                            <TextBox x:Name="MemoryInput"
                                     Height="60"
                                     FontSize="13"
                                     Foreground="#222"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0"/>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="RememberButton"
                                    Grid.Column="0"
                                    Content="記住"
                                    Height="34"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Background="#111"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="RememberPreference_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.Foreground="White"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="ClearMemoryButton"
                                    Grid.Column="2"
                                    Content="全部清除"
                                    Height="34"
                                    FontSize="12.5"
                                    Cursor="Hand"
                                    Background="#F1F1F3"
                                    Foreground="#444"
                                    BorderThickness="0"
                                    Click="ClearMemory_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="16,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E4E4E7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 已記住的偏好（整句完整保留，可捲動） -->
                    <ScrollViewer Grid.Row="2"
                                  Margin="0,14,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="PreferenceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F4F5FB"
                                            CornerRadius="10"
                                            Padding="12,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="6" Height="6"
                                                    CornerRadius="3"
                                                    Background="#5B6CFF"
                                                    VerticalAlignment="Top"
                                                    Margin="0,6,9,0"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Display}"
                                                       FontSize="12.5"
                                                       Foreground="#3A3A40"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="2"
                                                    Width="22" Height="22"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="刪除這條偏好"
                                                    Tag="{Binding Key}"
                                                    Click="DeletePreference_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="dbd" Background="Transparent" CornerRadius="6">
                                                            <Path Data="M4,4 L12,12 M12,4 L4,12"
                                                                  Stroke="#9A9AA0"
                                                                  StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="dbd" Property="Background" Value="#E2E3EC"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
